{
  "description": "Personal Codex lifecycle guardrails and workflow automation.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/git-worktree-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking worktree safety"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/pr-size-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking PR size"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/post-push-protocol.sh\"",
            "timeout": 5,
            "statusMessage": "Checking post-push follow-up"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/hooks/auto-format-on-edit.sh\"",
            "timeout": 10,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ]
  }
}
