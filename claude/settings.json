{
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Go mod tidy",
      "Go build",
      "Ls",
      "Git",
      "mcp__atlassian__confluence_get_page"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/saje.liese/.claude/hooks/git-worktree-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/saje.liese/.claude/hooks/gsd-check-update.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/saje.liese/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/Users/saje.liese/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true
  }
}
